{
  "enabled": false,
  "name": "Deploy SSP Portal to GitHub",
  "description": "DISABLED for team use: auto-committing + pushing on every .html/.js save bypasses the staged review gates (Gate 1 diff / local review / Theo sweep) and could push a half-edited prov_data.js live. With multiple maintainers, deploy manually via deploy_cloudflare.sh + git push, or via the Emily agent. Re-enable only for a solo, disciplined workflow.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.html",
      "*.js"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "cd \"c:\\Users\\sanniel\\Desktop\\SSP portal\\202606 working\" && git add index.html prov_data.js && git commit -m \"Update SSP Portal\" && git push origin main"
  },
  "workspaceFolderName": "202606 working",
  "shortName": "deploy-ssp-portal"
}